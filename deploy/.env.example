# =============================================================================
# Gamebot Warehouse Environment Configuration Template
# =============================================================================
# Copy this file to .env and customize for your production environment

# =============================================================================
# Core Database Configuration
# =============================================================================
DB_HOST=localhost
DB_NAME=survivor
DB_USER=survivor_user
DB_PASSWORD=change_this_password
DB_PORT=5433
DB_HOST_PORT=5433

# =============================================================================
# Application Configuration
# =============================================================================
SURVIVOR_ENV=prod
GAMEBOT_TARGET_LAYER=gold
GAMEBOT_DAG_SCHEDULE="0 4 * * 1"

# =============================================================================
# Airflow Configuration
# =============================================================================
AIRFLOW_PORT=8080
AIRFLOW_UID=50000

# Admin account created by airflow-init (defaults to admin/admin if unset).
# Change these before the first `docker compose up`; an existing user is not updated.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Encrypts connection passwords/variables in the Airflow metadata DB.
# Empty means stored unencrypted. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it stable once set; changing it makes existing encrypted values unreadable.
AIRFLOW_FERNET_KEY=

# =============================================================================
# Optional: GitHub Integration for Upstream Monitoring
# =============================================================================
# GITHUB_TOKEN=your_github_token_here
